# Copy this file to .env and fill it in:   cp .env.example .env
# (This .example file itself is never read.)

# REQUIRED. Clients send it in the X-API-Key header. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DOCPARSE_API_KEY=8R8_1Kg2rlAPckQwGJXkw-JfrGAGfga4EUh698IWr34

DOCPARSE_DEVICE=cpu
DOCPARSE_CPU_THREADS=8

# Limits
DOCPARSE_MAX_PAGES=100
DOCPARSE_MAX_UPLOAD_MB=50

# Turn features off you never need (saves memory and startup time)
DOCPARSE_ENABLE_FORMULAS=true
DOCPARSE_ENABLE_SEALS=false

# Routing thresholds - tune on ~50 of your own documents
DOCPARSE_HANDWRITING_THRESHOLD=0.80
DOCPARSE_HANDWRITING_PAGE_RATIO=0.30
DOCPARSE_MIN_TEXT_LAYER_CHARS=50
DOCPARSE_RENDER_DPI=200
